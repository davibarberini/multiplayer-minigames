{
  "name": "multiplayer-minigames",
  "version": "1.0.0",
  "description": "A real-time multiplayer mini-games platform",
  "private": true,
  "scripts": {
    "install:all": "pnpm -C minigames-backend install && pnpm -C minigames-frontend install",
    "dev:backend": "pnpm -C minigames-backend dev",
    "dev:frontend": "pnpm -C minigames-frontend dev",
    "build:backend": "pnpm -C minigames-backend build",
    "build:frontend": "pnpm -C minigames-frontend build",
    "build:all": "pnpm build:backend && pnpm build:frontend"
  },
  "keywords": [
    "multiplayer",
    "games",
    "websocket",
    "react",
    "typescript"
  ],
